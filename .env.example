# --- Admin login (/admin) -------------------------------------------------
# Required in production. In `npm run dev` the default password is "delgerzaya".
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign the login cookie (e.g. `openssl rand -hex 32`).
ADMIN_SECRET=

# --- Storage --------------------------------------------------------------
# Leave empty to store content in ./data and uploads in ./data/uploads (any server with a disk).
# Set both to use Supabase (required on Vercel). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=media

# --- Optional: email alerts for the contact form (https://resend.com) -----
RESEND_API_KEY=
# RESEND_FROM="Portfolio <hello@your-domain.com>"
# CONTACT_TO=fallback@example.com
